load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

TESTS = glob(["Test*.cpp"])

TEST_LIB = ["BridgeTestBase.cpp"]

TEST_LIB_HDRS = ["BridgeTestBase.h"]

MAINS = [
    "ClaimStats.cpp",
    "PbnRunner.cpp",
    "runRandom.cpp",
]

HDRS = [
    "Asserts.h",
    "Constants.h",
    "Exceptions.h",
]

cc_library(
    name = "hdrs",
    hdrs = HDRS,
)

HAND_HDRS = ["Hand.h"]

HAND_SRCS = ["Hand.cpp"]

cc_library(
    name = "hand",
    srcs = HAND_SRCS,
    hdrs = HAND_HDRS,
    deps = [":hdrs"],
)

cc_library(
    name = "dtac",
    srcs = glob(
        ["*.cpp"],
        exclude = MAINS + TESTS + HAND_SRCS + TEST_LIB,
    ),
    hdrs = glob(
        ["*.h"],
        exclude = HDRS + HAND_HDRS + TEST_LIB_HDRS,
    ),
    deps = [
        ":hand",
        ":hdrs",
    ],
)

[
    cc_binary(
        name = m[:-4],
        srcs = [m],
        deps = [":dtac"],
    )
    for m in MAINS
]

cc_library(
    name = "testlib",
    testonly = 1,
    srcs = TEST_LIB,
    hdrs = TEST_LIB_HDRS,
    deps = [
        ":dtac",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "unit_tests",
    size = "small",
    srcs = TESTS,
    deps = [
        ":dtac",
        ":testlib",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

genrule(
    name = "gentest",
    testonly = 1,
    outs = ["runtest.sh"],
    cmd = "echo '$$@' > $@",
)

test_suite(
    name = "all_tests",
    tags = ["-flaky"],
)

sh_test(
    name = "test_pbn",
    size = "small",
    srcs = [":gentest"],
    args = ["$(location :PbnRunner) $(location //dtac/testdata)"],
    data = [
        ":PbnRunner",
        "//dtac/testdata",
    ],
)

sh_test(
    name = "test_stats",
    size = "small",
    srcs = [":gentest"],
    args = ["$(location :ClaimStats) $(location //dtac/testdata)"],
    data = [
        ":ClaimStats",
        "//dtac/testdata",
    ],
)
